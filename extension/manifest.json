{
  "manifest_version": 3,
  "name": "WHYTV",
  "version": "0.3.0",
  "description": "YouTube TV with the feel of old-school antenna TV. Configure up to 13 channels.",
  "action": {
    "default_title": "WHYTV"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.youtube.com/*"],
      "js": ["content.js"],
      "css": ["vars.css", "content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "tabGroups", "sidePanel"],
  "host_permissions": ["https://tv.youtube.com/*"]
}
